# --- 目标芯片 ---
CONFIG_IDF_TARGET="esp32c3"
# 注:ESP32-C3 无 PSRAM,故不设 CONFIG_SPIRAM。

# --- Flash ---
# FoloToy AI Passport 当前产品/固件基线使用 8MB Flash。
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
# 固定 8MB 镜像头，关闭 detect，便于 idf.py merge-bin。
CONFIG_ESPTOOLPY_HEADER_FLASHSIZE_UPDATE=n
# 默认模板只保留 NVS、PHY data 和占用剩余空间的 factory app；用户可按需修改。
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"

# --- 控制台:USB-Serial-JTAG(C3 原生 USB,GPIO18/19)---
# 不用 UART0:其默认 TX=GPIO21 与本板背光引脚冲突。
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y

# --- LVGL ---
CONFIG_LV_COLOR_DEPTH_16=y
CONFIG_LV_FONT_MONTSERRAT_14=y
CONFIG_LV_FONT_MONTSERRAT_20=y
# LVGL 内置 malloc 池大小(KB)。它是独立静态区、不与系统堆共享,配大了会白白占用 RAM。
# 本 demo UI 简单,24KB 足够;若自建复杂界面出现绘制卡死/看门狗,调大此值。
CONFIG_LV_MEM_SIZE_KILOBYTES=48

# --- 小厨宝:菜谱封面 JPEG 解码 ---
# 封面以基线 JPEG(JFIF APP0)打包进 Flash,靠 LVGL 自带的 tjpgd 直接解码。
# tjpgd 按 MCU 行输出,只需要 4KB 工作缓冲,不需要整帧解码缓冲——这对无 PSRAM
# 的 ESP32-C3 很关键。
# 从内存变量解码必须打开 MEMFS:否则 lv_tjpgd 无法把 lv_image_dsc_t 的 data
# 包装成文件流,只会在日志里报 "LV_USE_FS_MEMFS needs to enabled"。
CONFIG_LV_USE_TJPGD=y
CONFIG_LV_USE_FS_MEMFS=y
# 驱动器标识字母必须是 'A'-'Z'(77 = 'M');留 0 会被判为非法字母,驱动注册不上。
CONFIG_LV_FS_MEMFS_LETTER=77

# --- 系统 ---
CONFIG_FREERTOS_HZ=1000
# main 任务栈。app_main 里会直接调 demo 的 enter(),其中对图片调用
# lv_image_set_src —— LVGL 会遍历所有已注册解码器的 info 回调,tjpgd 的
# decoder_info() 无条件在栈上开 4096 字节 workb。栈不够就
# "Stack protection fault" 整机重启(表现为反复闪屏)。涉及图片的入口必须 >=16KB。
CONFIG_ESP_MAIN_TASK_STACK_SIZE=16384
# ISR 栈默认 1536 偏小:I2S/GDMA 音频中断叠加日志打印会把它打爆,panic 里
# "Stack bounds" 的跨度会正好等于本值。音频类应用给到 3072。
CONFIG_FREERTOS_ISR_STACKSIZE=3072

# --- Bluetooth LE / NimBLE ---
# ESP32-C3 仅支持 BLE；示例只启用单连接 peripheral 所需的最小 host 配置。
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_ROLE_CENTRAL=n
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=y
CONFIG_BT_NIMBLE_ROLE_BROADCASTER=y
CONFIG_BT_NIMBLE_ROLE_OBSERVER=n
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
CONFIG_BT_NIMBLE_HOST_BASED_PRIVACY=n
CONFIG_BT_NIMBLE_NVS_PERSIST=n
